# Copy this file to .env.selfhost before starting Compose.
SELFHOST_DB_NAME=tdgpt
SELFHOST_DB_USER=tdgpt
SELFHOST_DB_PASSWORD=replace-with-a-long-random-password
SELFHOST_APP_URL=http://localhost:3000
# Optional: if omitted, the private worker reuses NEXTAUTH_SECRET from .env.
INTERNAL_SYNC_SECRET=
BOOKS_SYNC_INTERVAL_MS=300000

# Business identity, integration credentials, and notification addresses are
# loaded from the private .env file by the app container. In .env, configure
# the COMPANY_* address/contact values documented in SELF_HOSTING.md before
# enabling payments or return labels. PAYMENT_ALERT_EMAIL is optional.

# Optional secure public access. Create a remotely managed Cloudflare Tunnel,
# route its public hostname to http://app:3000, then set its token here.
# Also change SELFHOST_APP_URL above to the final https:// hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# Local text-generation defaults for this CPU-only proof of concept.
AI_PROVIDER=auto
AI_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=20000

# Optional path inside the app container for manual vendor CSV imports.
# VENDOR_CSV_PATH=/data/imports/vendors.csv
# ALL_PICS_DIR=/data/images
# PRODUCT_IMAGES_DIR=/app/public/product-images
# AUTOMATIONS_DIR=/opt/tdgpt-automations

# Optional cloud fallback. Keep the existing value in .env if desired.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Configure matching secrets in the app's private .env before enabling webhook
# URLs at Zoho or Easyship. Never commit their real values.
# ZOHO_WEBHOOK_SECRET=replace-with-a-long-random-secret
# ZOHO_VOICE_WEBHOOK_SECRET=replace-with-a-long-random-secret
# EASYSHIP_WEBHOOK_SECRET=replace-with-a-long-random-secret
