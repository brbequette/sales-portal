// ── Compensation Management ─────────────────────────────────────────

model CompensationPlan {
  id     String @id @default(cuid())
  repId  String
  name   String // e.g. "Bobby - Q3 2025 Plan"
  status String @default("ACTIVE") // ACTIVE, ENDED, DRAFT

  startDate DateTime
  endDate   DateTime?

  // Base Pay
  payType      String  @default("COMMISSION_ONLY")
  // SALARY, DRAW, HOURLY, COMMISSION_ONLY
  baseAmount   Float? // Dollar amount for base
  baseInterval String? // HOURLY, DAILY, WEEKLY, BIWEEKLY, MONTHLY, ANNUALLY

  // Commission Layer (variable per plan)
  commissionEnabled Boolean @default(true)
  commissionRate    Float? // e.g. 0.50 = 50%, 0.25 = 25%
  commissionBasis   String? // NET_PROFIT, DEAD_PROFIT, SUBTOTAL
  payoutStructure   String  @default("two_payment")
  // two_payment, single_payment, three_payment

  // Draw Rules
  drawRecoverable  Boolean @default(true)
  drawCapPerPeriod Float? // Max draw per pay period

  // Performance Commitment
  commitmentEnabled  Boolean @default(false)
  commitmentMetric   String? // SUBTOTAL, DEAD_PROFIT, NET_PROFIT, INVOICES_COUNT
  commitmentTarget   Float? // Target value
  commitmentVigRate  Float? // VIG rate tied to this commitment
  commitmentGoalType String? // DAILY, MONTHLY
  commitmentPenalty  String? // VIG_INCREASE, COMMISSION_REDUCTION, PLAN_REVIEW

  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  rep       User             @relation(fields: [repId], references: [id], onDelete: Cascade)
  earnings  BasePayEarning[]

  @@index([repId])
  @@index([status])
}

model BasePayEarning {
  id     String  @id @default(cuid())
  repId  String
  planId String?

  type        String // SALARY, DRAW, HOURLY, BONUS, ADJUSTMENT
  amount      Float
  periodStart DateTime // Pay period start (Monday)
  periodEnd   DateTime // Pay period end (Sunday)
  hoursWorked Float? // For hourly — pulled from TimeEntry
  hourlyRate  Float? // Snapshot of rate at time of calc

  description String?
  status      String    @default("PENDING") // PENDING, APPROVED, PAID
  paidDate    DateTime?
  payoutId    String? // Links to Payout when disbursed

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  rep       User              @relation(fields: [repId], references: [id], onDelete: Cascade)
  plan      CompensationPlan? @relation(fields: [planId], references: [id])

  @@index([repId])
  @@index([planId])
}

