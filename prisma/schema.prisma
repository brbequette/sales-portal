model AutoshipBundle {
  id          String   @id @default(cuid())
  name        String   // "Medusa Pro Pack"
  description String?
  items       Json     // [{sku, name, qty, unitPrice}]
  frequency   String   // "monthly" | "quarterly" | "biannual"
  discountPct Float    @default(0)  // additional discount for autoship
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions AutoshipSubscription[]
}

model AutoshipSubscription {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  bundleId    String
  bundle      AutoshipBundle @relation(fields: [bundleId], references: [id])
  items       Json     // snapshot of items at locked prices
  frequency   String   // "monthly" | "quarterly" | "biannual"
  nextShipDate DateTime
  status      String   @default("active") // active | paused | cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([status, nextShipDate])
}
