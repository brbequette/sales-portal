generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  password           String?
  name               String?
  zohoId             String?          @unique
  role               String           @default("AGENT")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  constantVigEnabled Boolean          @default(false)
  constantVigValue   Float?           @default(1.5)
  canSendCampaigns   Boolean          @default(false)
  accounts           Account[]
  campaignBlasts     CampaignBlast[]
  deals              Deal[]
  monthlyVigGoals    MonthlyVigGoal[]
  notes              Note[]
  payouts            Payout[]
  tasks              Task[]
  timeEntries        TimeEntry[]
  timeChangeRequests TimeChangeRequest[]
  smsMessages        SmsMessage[]
  callLogs           CallLog[]
}

model Account {
  id               String       @id @default(cuid())
  zohoId           String       @unique
  name             String
  industry         String?
  status           String       @default("Update Status")
  lastPurchaseAt   DateTime?
  ownerId          String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  nextActionDate   DateTime?
  tags             String?
  quality          String       @default("NEVER_STATUSED")
  lastCalledAt     DateTime?
  timeZone         String?
  bladeSizes       String?
  materialsCut     String?
  currentSupplier  String?
  averageBladeCost String?
  owner            User         @relation(fields: [ownerId], references: [id])
  contacts         Contact[]
  deals            Deal[]
  invoices         Invoice[]
  notes            Note[]
  quotes           Quote[]
  salesOrders      SalesOrder[]
  tasks            Task[]
  campaignLogs     CampaignLog[]
  smsMessages      SmsMessage[]
  callLogs         CallLog[]

  @@index([ownerId])
  @@index([status])
}

model Contact {
  id          String   @id @default(cuid())
  zohoId      String   @unique
  accountId   String
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  mobilePhone String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  account     Account  @relation(fields: [accountId], references: [id])
}

model Deal {
  id            String    @id @default(cuid())
  zohoId        String    @unique
  accountId     String
  name          String
  amount        Float
  stage         String    @default("Open")
  closingDate   DateTime?
  invoicedItems String?
  ownerId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  account       Account   @relation(fields: [accountId], references: [id])
  owner         User      @relation(fields: [ownerId], references: [id])
  tasks         Task[]

  @@index([ownerId])
  @@index([accountId])
}

model SalesOrder {
  id        String   @id @default(cuid())
  accountId String
  amount    Float
  status    String   @default("Pending")
  orderDate DateTime @default(now())
  items     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zohoId    String?  @unique
  account   Account  @relation(fields: [accountId], references: [id])
}

model Quote {
  id         String    @id @default(cuid())
  accountId  String
  amount     Float
  status     String    @default("Draft")
  validUntil DateTime?
  items      Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  zohoId     String?  @unique
  account    Account   @relation(fields: [accountId], references: [id])
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  description  String?
  price        Float
  category     String   @default("General")
  stock        Int      @default(0)
  subjectToVig Boolean  @default(true)
  giftItem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Invoice {
  id        String    @id @default(cuid())
  zohoId    String    @unique
  accountId String
  amount    Float
  status    String
  issueDate DateTime
  dueDate   DateTime?
  items     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([status])
}

model Note {
  id              String   @id @default(cuid())
  accountId       String
  authorId        String
  content         String
  callSid         String?
  sentiment       String?
  isAutoGenerated Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  account         Account  @relation(fields: [accountId], references: [id])
  author          User     @relation(fields: [authorId], references: [id])

  @@index([accountId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  title     String
  type      String
  category  String
  url       String
  size      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id           String    @id @default(cuid())
  zohoId       String    @unique
  subject      String
  description  String?
  status       String    @default("Not Started")
  priority     String    @default("Normal")
  dueDate      DateTime?
  ownerId      String
  accountId    String?
  dealId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoiceId    String?
  salesOrderId String?
  quoteId      String?
  estimateId   String?
  type         String    @default("Task")
  account      Account?  @relation(fields: [accountId], references: [id])
  deal         Deal?     @relation(fields: [dealId], references: [id])
  owner        User      @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([status])
  @@index([accountId])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payout {
  id         String   @id @default(cuid())
  repId      String
  amount     Float
  date       DateTime @default(now())
  method     String   @default("Check")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rep        User     @relation(fields: [repId], references: [id], onDelete: Cascade)

  @@index([repId])
}

model MonthlyVigGoal {
  id            String   @id @default(cuid())
  monthKey      String
  repId         String
  metric        String   @default("PROFIT")
  profitGoal    Float    @default(20000)
  subtotalGoal  Float    @default(40000)
  manualVigRate Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rep           User     @relation(fields: [repId], references: [id], onDelete: Cascade)

  @@unique([repId, monthKey])
  @@index([repId])
}

model TimeEntry {
  id              String   @id @default(cuid())
  userId          String
  date            String   // Stored as YYYY-MM-DD in Phoenix Time
  clockIn         DateTime
  lastActivity    DateTime
  clockOut        DateTime?
  manualClockIn   DateTime?
  manualClockOut  DateTime?
  ipAddress       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  changeRequests  TimeChangeRequest[]

  @@unique([userId, date])
  @@index([userId])
}

model TimeChangeRequest {
  id                String   @id @default(cuid())
  timeEntryId       String?
  userId            String
  requestedClockIn  DateTime?
  requestedClockOut DateTime?
  reason            String
  notes             String?
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  timeEntry         TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
  @@index([userId])
}

model CampaignTemplate {
  id          String   @id @default(cuid())
  name        String
  content     String
  imageUrl    String?
  channel     String   @default("SMS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CampaignBlast {
  id          String   @id @default(cuid())
  name        String
  content     String
  imageUrl    String?
  channel     String
  authorId    String
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())
  
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  logs        CampaignLog[]
  smsMessages SmsMessage[]

  @@index([authorId])
}

model CampaignLog {
  id               String   @id @default(cuid())
  campaignBlastId  String
  accountId        String
  contactId        String?
  zohoNumberUsed   String?
  status           String   // "SUCCESS", "FAILED"
  errorMessage     String?
  sentAt           DateTime @default(now())
  
  campaignBlast    CampaignBlast @relation(fields: [campaignBlastId], references: [id], onDelete: Cascade)
  account          Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([campaignBlastId])
  @@index([accountId])
}

model SmsMessage {
  id              String   @id @default(cuid())
  accountId       String
  authorId        String?  // null if incoming
  fromNumber      String
  toNumber        String
  body            String
  direction       String   // "INBOUND" | "OUTBOUND"
  campaignBlastId String?
  isAiGenerated   Boolean  @default(false)
  createdAt       DateTime @default(now())

  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  author          User?    @relation(fields: [authorId], references: [id])
  campaignBlast   CampaignBlast? @relation(fields: [campaignBlastId], references: [id])

  @@index([accountId])
  @@index([campaignBlastId])
}

model CallScript {
  id        String   @id @default(cuid())
  name      String
  callType  String   // e.g., "Intro", "Follow-up", "Collections", "General"
  content   String   // The text with merge fields
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallLog {
  id          String   @id @default(cuid())
  accountId   String
  authorId    String
  fromNumber  String
  toNumber    String
  direction   String   // "INBOUND" | "OUTBOUND"
  duration    Int      @default(0) // Duration in seconds
  status      String   // "completed", "missed", "voicemail", etc.
  notes       String?
  zohoCallId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  editedAt    DateTime?

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([authorId])
}
