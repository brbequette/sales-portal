generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // Nullable because Zoho SSO might not have one initially
  name      String?
  zohoId    String?  @unique // ID mapped from Zoho CRM
  role      String   @default("AGENT")
  accounts  Account[] // Accounts owned by this sales rep
  notes     Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id             String   @id @default(cuid())
  zohoId         String   @unique
  name           String
  industry       String?
  status         String   @default("Update Status") // 'Personal', 'Update Status', 'Open'
  lastPurchaseAt DateTime?
  nextActionDate DateTime?
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id])
  invoices       Invoice[]
  salesOrders    SalesOrder[]
  quotes         Quote[]
  notes          Note[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SalesOrder {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  amount      Float
  status      String   @default("Pending") // Pending, Processed, Shipped
  orderDate   DateTime @default(now())
  items       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  amount      Float
  status      String   @default("Draft") // Draft, Sent, Accepted, Rejected
  validUntil  DateTime?
  items       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  price       Float
  category    String   @default("General")
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id          String   @id @default(cuid())
  zohoId      String   @unique
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  amount      Float
  status      String   // e.g., 'Paid', 'Overdue'
  issueDate   DateTime
  dueDate     DateTime?
  items       Json?    // Store line items here
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  callSid     String?  // If tied to a Zoho Voice call
  sentiment   String?  // AI analyzed sentiment
  isAutoGenerated Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
