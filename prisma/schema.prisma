  resolvedEntityId String?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([integration, entityType, externalId, exceptionType])
  @@index([status, createdAt])
  @@index([entityType, status])
}

model TaskOutcome {
  id           String    @id @default(cuid())
  taskId       String
  outcomeType  String
  summary      String
  nextAction   String?
  followUpAt   DateTime?
  accountId    String?
  documentType String?
  documentId   String?
  actorId      String?
  actorName    String?
  createdAt    DateTime  @default(now())

  @@index([taskId, createdAt])
  @@index([accountId, createdAt])
  @@index([outcomeType, createdAt])
}

model ShippingPreset {
  id        String   @id @default(cuid())
  name      String
  length    Float
  width     Float
  height    Float
  weight    Float
  scope     String   @default("COMPANY")
  ownerId   String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, scope, ownerId])
  @@index([scope, isActive])
}

/// A reviewed promotion definition used by Flyer Studio. The bundle snapshot
/// keeps historical pricing intact even when catalog costs change later.
model PromotionDraft {
  id                 String    @id @default(cuid())
  name               String
  sku                String    @unique
  status             String    @default("DRAFT") // DRAFT | READY | PUBLISHED | ARCHIVED
  repId              String?
  campaignTemplateId String?
  localProductId     String?
  zohoItemId         String?
  sourceUrl          String?
  giveawayName       String?
  giveawayImageUrl   String?
  referenceImages    Json?
  bundleItems        Json
  marketingCopy      Json
  financials         Json
  flyerSmsImage      String?
  flyerEmailImage    String?
  createdBy          String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([repId])
  @@index([campaignTemplateId])
  @@index([createdAt])
}
