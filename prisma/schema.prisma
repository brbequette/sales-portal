generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // Nullable because Zoho SSO might not have one initially
  name      String?
  zohoId    String?  @unique // ID mapped from Zoho CRM
  role      String   @default("AGENT")
  accounts  Account[] // Accounts owned by this sales rep
  deals     Deal[]    // Deals owned by this sales rep
  notes     Note[]
  tasks     Task[]    // Tasks assigned to this sales rep
  payouts   Payout[]  // Commission payouts for this sales rep
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id             String   @id @default(cuid())
  zohoId         String   @unique
  name           String
  industry       String?
  tags           String?
  status         String   @default("Update Status") // 'Personal', 'Update Status', 'Open'
  quality        String   @default("WARM")
  lastCalledAt   DateTime?
  lastPurchaseAt DateTime?
  nextActionDate DateTime?
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id])
  timeZone       String?
  invoices       Invoice[]
  salesOrders    SalesOrder[]
  quotes         Quote[]
  deals          Deal[]
  notes          Note[]
  tasks          Task[]
  contacts       Contact[]
  bladeSizes     String?
  materialsCut   String?
  currentSupplier String?
  averageBladeCost String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model Contact {
  id          String   @id @default(cuid())
  zohoId      String   @unique
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  mobilePhone String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Deal {
  id             String   @id @default(cuid())
  zohoId         String   @unique
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  name           String
  amount         Float
  stage          String   @default("Open")
  closingDate    DateTime?
  invoicedItems  String?
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id])
  tasks          Task[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([accountId])
}

model SalesOrder {
  id          String   @id @default(cuid())
  zohoId      String?
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  amount      Float
  status      String   @default("Pending") // Pending, Processed, Shipped
  orderDate   DateTime @default(now())
  items       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id          String   @id @default(cuid())
  zohoId      String?
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  amount      Float
  status      String   @default("Draft") // Draft, Sent, Accepted, Rejected
  validUntil  DateTime?
  items       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  price       Float
  category    String   @default("General")
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id          String   @id @default(cuid())
  zohoId      String   @unique
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  amount      Float
  status      String   // e.g., 'Paid', 'Overdue'
  issueDate   DateTime
  dueDate     DateTime?
  items       Json?    // Store line items here
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([status])
}

model Note {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  callSid     String?  // If tied to a Zoho Voice call
  sentiment   String?  // AI analyzed sentiment
  isAutoGenerated Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  title     String
  type      String   // PDF, Image, Video, ZIP, Link
  category  String   // Brochures, Spec Sheets, Social Media, Training, Branding
  url       String
  size      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  zohoId      String   @unique
  subject     String
  description String?
  status      String   @default("Not Started")
  priority    String   @default("Normal")
  dueDate     DateTime?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])
  invoiceId   String?
  salesOrderId String?
  quoteId     String?
  estimateId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([accountId])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payout {
  id        String   @id @default(cuid())
  repId     String
  rep       User     @relation(fields: [repId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repId])
}
