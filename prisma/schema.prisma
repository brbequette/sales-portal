/// Durable record of every operational write, including Zoho-bound work.
/// idempotencyKey prevents double-submission across refreshes and retries.
model OperationalAction {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  actionType     String
  entityType     String
  entityId       String
  entityNumber   String?
  accountId      String?
  status         String    @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED | DEAD_LETTER
  payload        Json?
  result         Json?
  errorCode      String?
  errorMessage   String?
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(5)
  nextAttemptAt  DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  actorId        String?
  actorName      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId, createdAt])
  @@index([accountId, createdAt])
}

