  @@index([createdAt])
}

model DealAutomationState {
  id              String   @id @default(cuid())
  dealId          String   @unique
  salesStageId    String
  currentStep     Int      @default(0)    // Current step index in flowConfig.steps[]
  loopCount       Int      @default(0)    // How many times the flow has looped
  maxLoops        Int      @default(3)    // Max loops before stopping
  lastExecutedAt  DateTime?               // When the last step was executed
  nextExecuteAt   DateTime?               // When the next step should execute
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | CANCELLED
  metadata        Json?                   // Any step-specific state data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([nextExecuteAt])
  @@index([salesStageId])
}

model Email {
